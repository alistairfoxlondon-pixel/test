---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  categoryPath: string;
  updatedAt?: string;
}

const { title, description, category, categoryPath, updatedAt = new Date().toISOString().split('T')[0] } = Astro.props;

// Basic FAQ Schema generator
const getFAQSchema = () => {
  return {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [] // This will be populated by the specific calculator pages
  };
};

const getSoftwareAppSchema = () => {
  return {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": title,
    "description": description,
    "applicationCategory": "CalculatorApplication",
    "operatingSystem": "All",
    "offers": {
      "@type": "Offer",
      "price": "0"
    }
  };
};
---

<Layout title={title} description={description} type="website">
  <!-- Schema Injection Placeholder -->
  <slot name="schema">
    <script type="application/ld+json" set:html={JSON.stringify(getSoftwareAppSchema())} />
  </slot>

  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex mb-6 text-sm text-slate-500 dark:text-slate-400 overflow-x-auto whitespace-nowrap pb-2">
      <a href="/" class="hover:text-teal-600 dark:hover:text-teal-400">Home</a>
      <span class="mx-2">/</span>
      <a href="/categories" class="hover:text-teal-600 dark:hover:text-teal-400">Categories</a>
      <span class="mx-2">/</span>
      <a href={categoryPath} class="hover:text-teal-600 dark:hover:text-teal-400">{category}</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium truncate">{title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Content Area -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Header -->
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-3">
            {title}
          </h1>
          <p class="text-lg text-slate-600 dark:text-slate-300">
            {description}
          </p>
          <div class="mt-3 flex items-center text-xs text-slate-500 dark:text-slate-400">
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Updated: {updatedAt}
            </span>
            <span class="mx-3">•</span>
            <span class="inline-block px-2 py-0.5 font-medium text-teal-700 bg-teal-50 dark:text-teal-300 dark:bg-teal-900/30 rounded">
              {category}
            </span>
          </div>
        </div>

        <!-- Ad Slot (Top) -->
        <div class="w-full h-[90px] bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 text-sm rounded overflow-hidden">
          AdSense Responsive Slot
        </div>

        <!-- The actual interactive calculator component goes here -->
        <div class="calculator-container bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
          <slot name="calculator" />
        </div>

        <!-- Content Area: Guide & Examples -->
        <div class="prose prose-slate dark:prose-invert max-w-none pt-4">
          <slot name="content" />
        </div>

        <!-- Ad Slot (Bottom/Middle Content) -->
        <div class="w-full h-[250px] bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 text-sm rounded overflow-hidden">
          AdSense Rectangle
        </div>

        <!-- FAQ Section -->
        <div class="pt-6 border-t border-slate-200 dark:border-slate-800">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Frequently Asked Questions</h2>
          <div class="space-y-6">
            <slot name="faq" />
          </div>
        </div>

      </div>

      <!-- Sidebar Area -->
      <div class="space-y-8">
        <!-- Related Calculators -->
        <div class="card bg-slate-50 dark:bg-slate-800/50">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center">
            <svg class="w-5 h-5 mr-2 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            Related Tools
          </h3>
          <ul class="space-y-3">
            <slot name="related" />
          </ul>
        </div>

        <!-- Sidebar Ad Slot -->
        <div class="w-full h-[600px] hidden lg:flex bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 items-center justify-center text-slate-400 text-sm rounded sticky top-24">
          AdSense Skyscraper
        </div>
      </div>

    </div>
  </div>
</Layout>
