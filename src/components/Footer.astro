---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-auto">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="col-span-1 md:col-span-2">
        <span class="text-xl font-bold text-teal-600 dark:text-teal-400 tracking-tight flex items-center gap-2 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
            <rect x="8" y="8" width="3" height="3"></rect>
            <rect x="13" y="8" width="3" height="3"></rect>
            <rect x="8" y="13" width="8" height="3"></rect>
          </svg>
          SG Calc
        </span>
        <p class="text-slate-500 dark:text-slate-400 text-sm max-w-sm">
          The fast, reliable calculator hub for Singaporeans. Academic, financial, lifestyle tools, and more.
        </p>
      </div>
      
      <div>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">Tools</h3>
        <ul class="space-y-3">
          <li><a href="/categories/academic" class="text-sm text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400">Academic & Education</a></li>
          <li><a href="/categories/finance" class="text-sm text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400">Financial & Business</a></li>
          <li><a href="/categories/vehicle" class="text-sm text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400">Vehicle & Transport</a></li>
          <li><a href="/categories" class="text-sm text-teal-600 hover:text-teal-700 dark:text-teal-400 dark:hover:text-teal-300 font-medium">All Categories &rarr;</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">Legal</h3>
        <ul class="space-y-3">
          <li><a href="/about" class="text-sm text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400">About Us</a></li>
          <li><a href="/contact" class="text-sm text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400">Contact</a></li>
          <li><a href="/privacy" class="text-sm text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-slate-500 hover:text-teal-600 dark:text-slate-400 dark:hover:text-teal-400">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    
    <div class="mt-8 border-t border-slate-200 dark:border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center">
      <p class="text-sm text-slate-400 dark:text-slate-500">
        &copy; {currentYear} SG Calc. All rights reserved. Made for Singapore.
      </p>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-4 md:mt-0 text-center md:text-right max-w-lg">
        Disclaimer: All calculators are for reference purposes only. Please confirm with official institutions or professionals for critical decisions.
      </p>
    </div>
  </div>
</footer>
