---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import SussGpaCalculatorWidget from '../components/calculators/SussGpaCalculator';

const relatedCalculators = [
  { title: "NUS CAP Calculator", path: "/nus-cap-calculator" },
  { title: "NTU CGPA Calculator", path: "/ntu-cgpa-calculator" },
  { title: "SMU GPA Calculator", path: "/smu-gpa-calculator" },
];
---

<CalculatorLayout
  title="SUSS GPA Calculator"
  description="Calculate your Cumulative Grade Point Average (CGPA) for the Singapore University of Social Sciences (SUSS). Includes SUSS-specific degree classifications."
  category="Academic & Education"
  categoryPath="/categories/academic"
>
  <SussGpaCalculatorWidget client:load slot="calculator" />

  <Fragment slot="content">
    <h2>How to use the SUSS GPA Calculator</h2>
    <p>
      The <strong>SUSS CGPA Calculator</strong> helps students at the Singapore University of Social Sciences track their academic performance. SUSS uses a 5.0 grade point system similar to other local universities, but often has different credit unit weightings (e.g., 2.5 or 5.0 CUs per course).
    </p>
    <p>
      To use the calculator:
    </p>
    <ol>
      <li><strong>(Optional) Enter your current standing:</strong> Input your current CGPA and the total number of graded Credit Units (CUs) you have completed.</li>
      <li><strong>Add your current courses:</strong> For each course, enter the CUs (commonly 2.5 or 5.0) and your expected grade.</li>
      <li><strong>Pass/Fail Options:</strong> If a course is taken on a Pass/Fail basis, select 'P' or 'F (Pass/Fail)'. These will not affect your CGPA calculation.</li>
    </ol>
    <p>
      The tool will immediately calculate your semester GPA, update your overall CGPA, and project your degree classification.
    </p>

    <h3>SUSS Grade Points Table</h3>
    <p>SUSS calculates CGPA out of a maximum of 5.0:</p>
    <ul>
      <li><strong>A+ / A:</strong> 5.0</li>
      <li><strong>A-:</strong> 4.5</li>
      <li><strong>B+:</strong> 4.0</li>
      <li><strong>B:</strong> 3.5</li>
      <li><strong>B-:</strong> 3.0</li>
      <li><strong>C+:</strong> 2.5</li>
      <li><strong>C:</strong> 2.0</li>
      <li><strong>D+:</strong> 1.5</li>
      <li><strong>D:</strong> 1.0</li>
      <li><strong>F:</strong> 0.0</li>
    </ul>

    <h3>SUSS Degree Classification (Honours)</h3>
    <p>SUSS awards degrees with the following classifications for students in Honours programmes:</p>
    <ul>
      <li><strong>Honours (Highest Distinction):</strong> CGPA 4.50 - 5.00</li>
      <li><strong>Honours (Distinction):</strong> CGPA 4.00 - 4.49</li>
      <li><strong>Honours (Merit):</strong> CGPA 3.50 - 3.99</li>
      <li><strong>Honours:</strong> CGPA 3.00 - 3.49</li>
      <li><strong>Pass:</strong> CGPA 2.00 - 2.99</li>
    </ul>
    <p><em>Note: For basic degree programmes without Honours, graduating with a CGPA of 2.00 and above results in a 'Pass'.</em></p>
  </Fragment>

  <Fragment slot="faq">
    <div class="space-y-4">
      <details class="group bg-slate-50 dark:bg-slate-800/50 p-4 rounded-lg">
        <summary class="font-medium cursor-pointer list-none flex justify-between items-center text-slate-900 dark:text-slate-100">
          How do I handle 2.5 CU courses?
          <span class="transition group-open:rotate-180">
            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
          </span>
        </summary>
        <p class="text-slate-600 dark:text-slate-300 mt-3">
          Our calculator allows decimal inputs for Credit Units. Simply enter '2.5' in the CUs field for those specific courses.
        </p>
      </details>
      <details class="group bg-slate-50 dark:bg-slate-800/50 p-4 rounded-lg">
        <summary class="font-medium cursor-pointer list-none flex justify-between items-center text-slate-900 dark:text-slate-100">
          What happens if I withdraw (W grade) from a course?
          <span class="transition group-open:rotate-180">
            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
          </span>
        </summary>
        <p class="text-slate-600 dark:text-slate-300 mt-3">
          A 'W' (Withdrawn) grade indicates that you withdrew from the course within the allowed period. It carries no grade points and the CUs are not factored into your CGPA calculation.
        </p>
      </details>
    </div>
  </Fragment>

  <Fragment slot="related">
    {relatedCalculators.map(calc => (
      <li>
        <a href={calc.path} class="group flex items-center p-2 rounded-md hover:bg-white dark:hover:bg-slate-700 transition-colors">
          <svg class="w-4 h-4 mr-2 text-slate-400 group-hover:text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300 group-hover:text-teal-600 dark:group-hover:text-teal-400">{calc.title}</span>
        </a>
      </li>
    ))}
  </Fragment>
</CalculatorLayout>
