---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar';

const featuredCalculators = [
  { title: "NUS CAP Calculator", path: "/nus-cap-calculator", category: "Academic", desc: "Calculate your Cumulative Average Point for National University of Singapore." },
  { title: "NTU CGPA Calculator", path: "/ntu-cgpa-calculator", category: "Academic", desc: "Track and project your Nanyang Technological University CGPA." },
  { title: "RP GPA Calculator", path: "/rp-gpa-calculator", category: "Academic", desc: "Calculate your Republic Polytechnic Grade Point Average easily." },
  { title: "GST + Service Charge", path: "/gst-service-charge-calculator", category: "Finance", desc: "Quickly split bills with the latest Singapore GST and service charge rates." },
  { title: "CPF Contribution", path: "#", category: "Finance", desc: "Estimate your monthly CPF contributions based on age and wage." },
  { title: "BMI Calculator (SG)", path: "#", category: "Health", desc: "Check your Body Mass Index using Asian-specific thresholds." },
];
---

<Layout 
  title="Home" 
  description="SG Calc - The fast, reliable, and free calculator hub for Singaporeans. Academic, financial, vehicle, and lifestyle tools."
>
  <!-- Hero Section -->
  <section class="text-center py-16 sm:py-24">
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-6">
      Calculate Anything, <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-teal-400">Instantly.</span>
    </h1>
    <p class="mt-4 text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-10">
      The ultimate collection of calculators built specifically for Singaporeans. Fast, private, and easy to use.
    </p>
    
    <div class="max-w-xl mx-auto mb-16">
      <SearchBar client:load />
    </div>

    <!-- Ad Slot Placeholder (Hero) -->
    <div class="w-full max-w-3xl mx-auto h-24 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 text-sm mb-16 rounded">
      AdSense Responsive Slot
    </div>
  </section>

  <!-- Featured Calculators Grid -->
  <section class="mb-20">
    <div class="flex justify-between items-end mb-8">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Popular Right Now</h2>
      <a href="/categories" class="text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 font-medium text-sm">View all &rarr;</a>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredCalculators.map(calc => (
        <a href={calc.path} class="group card hover:shadow-md transition-shadow relative flex flex-col justify-between items-start text-left h-full">
          <div>
            <span class="inline-block px-2 py-1 text-xs font-medium text-teal-700 bg-teal-50 dark:text-teal-300 dark:bg-teal-900/30 rounded mb-3">
              {calc.category}
            </span>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2 group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors">
              {calc.title}
            </h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">
              {calc.desc}
            </p>
          </div>
          <span class="text-teal-600 dark:text-teal-400 text-sm font-medium flex items-center mt-auto group-hover:translate-x-1 transition-transform">
            Calculate <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Categories Quick Links -->
  <section class="mb-20">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-8">Browse by Category</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/categories/academic" class="card text-center hover:border-teal-500 transition-colors p-6 flex flex-col items-center justify-center">
        <span class="text-3xl mb-2">🎓</span>
        <span class="font-medium text-slate-900 dark:text-white">Academic</span>
      </a>
      <a href="/categories/finance" class="card text-center hover:border-teal-500 transition-colors p-6 flex flex-col items-center justify-center">
        <span class="text-3xl mb-2">💰</span>
        <span class="font-medium text-slate-900 dark:text-white">Finance</span>
      </a>
      <a href="/categories/vehicle" class="card text-center hover:border-teal-500 transition-colors p-6 flex flex-col items-center justify-center">
        <span class="text-3xl mb-2">🚗</span>
        <span class="font-medium text-slate-900 dark:text-white">Vehicle</span>
      </a>
      <a href="/categories/health" class="card text-center hover:border-teal-500 transition-colors p-6 flex flex-col items-center justify-center">
        <span class="text-3xl mb-2">🏥</span>
        <span class="font-medium text-slate-900 dark:text-white">Health</span>
      </a>
    </div>
  </section>
</Layout>
