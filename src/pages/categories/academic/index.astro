---
import Layout from '../../../layouts/Layout.astro';

const calculators = [
  { title: "NUS CAP Calculator", path: "/nus-cap-calculator", desc: "Calculate your Cumulative Average Point for National University of Singapore." },
  { title: "NUS GPA Calculator", path: "/nus-gpa-calculator", desc: "Calculate your Grade Point Average for National University of Singapore." },
  { title: "NUS Grade Calculator", path: "/nus-grade-calculator", desc: "Calculate your target grades for NUS modules." },
  { title: "NTU CGPA Calculator", path: "/ntu-cgpa-calculator", desc: "Calculate your Cumulative Grade Point Average for Nanyang Technological University." },
  { title: "NTU Grade Calculator", path: "/ntu-grade-calculator", desc: "Calculate your target grades for NTU modules." },
  { title: "SMU GPA Calculator", path: "/smu-gpa-calculator", desc: "Calculate your Grade Point Average for Singapore Management University." },
  { title: "SUSS GPA Calculator", path: "/suss-gpa-calculator", desc: "Calculate your Grade Point Average for Singapore University of Social Sciences." },
  { title: "SIT GPA Calculator", path: "/sit-gpa-calculator", desc: "Calculate your Grade Point Average for Singapore Institute of Technology." },
  { title: "RP GPA Calculator", path: "/rp-gpa-calculator", desc: "Calculate your Grade Point Average for Republic Polytechnic." },
  { title: "NYP GPA Calculator", path: "/nyp-gpa-calculator", desc: "Calculate your Grade Point Average for Nanyang Polytechnic." },
];
---

<Layout 
  title="Academic & Education Calculators" 
  description="Free calculators for Singapore students. Calculate NUS CAP, NTU CGPA, Poly GPA, A-Level Rank Points, PSLE scores, and more."
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex mb-6 text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-teal-600 dark:hover:text-teal-400">Home</a>
      <span class="mx-2">/</span>
      <a href="/categories" class="hover:text-teal-600 dark:hover:text-teal-400">Categories</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 dark:text-slate-200 font-medium">Academic & Education</span>
    </nav>

    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-4 flex items-center">
        <span class="mr-3 text-4xl">🎓</span> Academic & Education
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300">
        Tools designed specifically for the Singapore education system. Calculate your polytechnic GPA, university CAP/CGPA, or national exam scores.
      </p>
    </div>

    <!-- Ad Slot -->
    <div class="w-full h-24 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 text-sm mb-10 rounded">
      AdSense Responsive Slot
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-16">
      {calculators.map(calc => (
        <a href={calc.path} class="card hover:border-teal-500 transition-colors p-5 flex flex-col justify-between">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{calc.title}</h2>
            <p class="text-slate-500 dark:text-slate-400 text-sm">
              {calc.desc}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
