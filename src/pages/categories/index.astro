---
import Layout from '../../layouts/Layout.astro';

const categories = [
  { id: "academic", title: "Academic & Education", icon: "🎓", desc: "GPA, CAP, PSLE, O/A Levels, and more for Singapore students." },
  { id: "finance", title: "Financial & Business", icon: "💰", desc: "GST, CPF, Net Worth, Loans, and business calculators." },
  { id: "vehicle", title: "Vehicle & Transport", icon: "🚗", desc: "COE, Car Depreciation, Loan, and transport costs." },
  { id: "employment", title: "Employment & HR", icon: "💼", desc: "Leave, OT Pay, Public Holiday Pay, and HR tools." },
  { id: "health", title: "Health & Medical", icon: "🏥", desc: "BMI, dosage calculators, and health risk assessments." },
  { id: "engineering", title: "Engineering & Science", icon: "⚙️", desc: "BTU, weight, electrical, and scientific conversions." },
  { id: "lifestyle", title: "Astrology, Spiritual & Lifestyle", icon: "✨", desc: "BaZi, Zakat, wedding dates, and lifestyle tools." },
  { id: "gaming", title: "Gaming & Hobbies", icon: "🎮", desc: "MapleStory, Dartslive, and hobby-specific calculators." },
];
---

<Layout 
  title="All Categories" 
  description="Browse all calculator categories on SG Calc. Find exactly what you need for academic, financial, or daily life in Singapore."
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white tracking-tight mb-4">
        Calculator Categories
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300">
        Browse our comprehensive list of calculators designed for Singapore.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {categories.map(cat => (
        <a href={`/categories/${cat.id}`} class="card hover:border-teal-500 transition-colors flex items-start p-6">
          <div class="text-4xl mr-4">{cat.icon}</div>
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{cat.title}</h2>
            <p class="text-slate-500 dark:text-slate-400 text-sm">
              {cat.desc}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- Ad Slot -->
    <div class="w-full h-24 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 text-sm mb-16 rounded">
      AdSense Responsive Slot
    </div>
  </div>
</Layout>
